# Hoist CSS toolchain packages to workspace root node_modules so that
# webpack's enhanced-resolve finds them when it walks up from symlinked
# pnpm package paths (e.g. .pnpm/@tailwindcss+postcss/node_modules/...)
# Without this, resolution context lands on main/package.json and
# skips the app's own node_modules entirely.
public-hoist-pattern[]=tailwindcss
public-hoist-pattern[]=@tailwindcss/*
public-hoist-pattern[]=postcss
public-hoist-pattern[]=postcss-*
