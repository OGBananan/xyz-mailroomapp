PORT=4000
NODE_ENV=development

# Google OAuth — from client_secret_*.json
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-secret
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-secret
# Must exactly match an Authorised Redirect URI in Google Cloud Console
# Local:  http://localhost:4000/auth/google/callback
# Prod:   https://mailroomapp.xyz/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

# Session (any random 32+ char string — generate with: openssl rand -hex 32)
SESSION_SECRET=replace_me_with_a_random_32_char_string
SESSION_TTL_SECONDS=604800

# AWS
AWS_REGION=ap-south-1

# AgentCore — two separate runtimes
AGENT_RUNTIME_URL=http://localhost:8080
EVALUATOR_RUNTIME_ARN=
DRAFT_RUNTIME_ARN=
AGENTCORE_QUALIFIER=
# Set to 'stub' to skip real AgentCore calls during local dev
AGENT_CLIENT=stub

# Agent timeout (ms)
AGENT_TIMEOUT_MS=60000

# Frontend
FRONTEND_ORIGIN=http://localhost:3000

# Sync
SYNC_BACKFILL_MAX=50
